      ]
    },
    "mux-context": {
      "ascii_globs": [
        ".github/**",
        "scripts/**",
        "**/*.json",
        "**/*.lock",
        "**/*.toml",
        "**/*.yml",
        "**/*.yaml",
        "AGENTS.md",
        "SKILL.md",
        "docs/release-process.md",
        "docs/repo-governance.md",
        "llms.txt",
        "sonar-project.properties"
      ],
      "unicode_allowed": [
