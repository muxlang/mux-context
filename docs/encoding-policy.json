      ]
    },
    "mux-examples": {
      "ascii_globs": [
        ".github/**",
        "scripts/**",
        "**/*.json",
        "**/*.lock",
        "**/*.toml",
        "**/*.yml",
        "**/*.yaml",
        "AGENTS.md",
        "llms.txt",
        "sonar-project.properties"
      ],
      "unicode_allowed": [
        {
          "glob": "**/*.md",
          "reason": "Teaching documentation may use natural-language Unicode."
